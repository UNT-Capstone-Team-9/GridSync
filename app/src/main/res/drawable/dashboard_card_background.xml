<?xml version="1.0" encoding="utf-8"?>
<!-- Main dashboard action card with a green touch ripple. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/gridsync_ripple">
    <item>
        <shape>
            <solid android:color="@color/gridsync_surface" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="@color/gridsync_border" />
        </shape>
    </item>
</ripple>

<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/gridsync_surface_alt" />
            <corners android:radius="12dp" />
            <stroke android:width="1.5dp" android:color="@color/gridsync_green" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/gridsync_surface_alt" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/gridsync_border" />
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<!-- Tappable row in dark lists, such as connected watches. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/gridsync_ripple">
    <item>
        <shape>
            <solid android:color="@color/gridsync_surface_alt" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/gridsync_border" />
        </shape>
    </item>
</ripple>

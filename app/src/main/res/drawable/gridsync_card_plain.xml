<?xml version="1.0" encoding="utf-8"?>
<!-- Action card: a green border that is brightest at the top left and fades out, a dark surface
     with a soft green glow from the same corner, optional faint artwork and a green ripple. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/gridsync_ripple">
    <item>
        <shape>
            <gradient
                android:angle="315"
                android:centerColor="@color/gridsync_card_border"
                android:endColor="@color/gridsync_border"
                android:startColor="#B346D369" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item
        android:bottom="1.5dp"
        android:left="1.5dp"
        android:right="1.5dp"
        android:top="1.5dp">
        <shape>
            <solid android:color="@color/gridsync_surface" />
            <corners android:radius="14.5dp" />
        </shape>
    </item>
    <item
        android:bottom="1.5dp"
        android:left="1.5dp"
        android:right="1.5dp"
        android:top="1.5dp">
        <shape>
            <gradient
                android:centerX="0.1"
                android:centerY="0"
                android:endColor="#0046D369"
                android:gradientRadius="75%p"
                android:startColor="#3846D369"
                android:type="radial" />
            <corners android:radius="14.5dp" />
        </shape>
    </item>
</ripple>

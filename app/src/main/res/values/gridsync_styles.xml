<?xml version="1.0" encoding="utf-8"?>
<!-- Shared look for the GridSync tablet screens (dashboard, Plays, Assign Watches, Send Messages). -->
<resources>
    <!-- Empty parent so the GridSync.* styles below resolve. -->
    <style name="GridSync" />

    <style name="GridSync.Header">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">88dp</item>
        <item name="android:background">@drawable/gridsync_header_background</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">24dp</item>
    </style>

    <style name="GridSync.BackButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/dashboard_icon_ripple</item>
        <item name="android:contentDescription">Back</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:src">@drawable/ic_gs_back</item>
    </style>

    <style name="GridSync.HeaderLogo">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:contentDescription">GridSync logo</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:src">@drawable/gridsync_logo_shield</item>
    </style>

    <style name="GridSync.ScreenTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:textColor">@color/gridsync_text_primary</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="GridSync.Panel">
        <item name="android:background">@drawable/dashboard_panel_background</item>
        <item name="android:elevation">4dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="GridSync.PanelTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/gridsync_text_primary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="GridSync.AccentRule">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">3dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/gridsync_accent_rule</item>
    </style>

    <style name="GridSync.Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/gridsync_divider</item>
    </style>

    <style name="GridSync.CardTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/gridsync_text_primary</item>
        <item name="android:textSize">23sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="GridSync.CardBody">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:lineSpacingExtra">1dp</item>
        <item name="android:textColor">@color/gridsync_text_secondary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="GridSync.CardIcon">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="GridSync.PrimaryButton">
        <item name="android:background">@drawable/gridsync_button_primary</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/gridsync_background</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<!-- Send Messages (coach text messages to selected roles) in the shared GridSync dark style.
     SendPlayActivity looks up backButton, messageInput, sendButton and roleStatusContainer. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gridsync_background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/headerBar"
        style="@style/GridSync.Header">

        <ImageButton
            android:id="@+id/backButton"
            style="@style/GridSync.BackButton" />

        <ImageView style="@style/GridSync.HeaderLogo" />

        <TextView
            style="@style/GridSync.ScreenTitle"
            android:text="Send Messages" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="20dp">

        <LinearLayout
            android:id="@+id/leftPanel"
            style="@style/GridSync.Panel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="16dp"
            android:layout_weight="1.6"
            android:padding="22dp">

            <TextView
                style="@style/GridSync.PanelTitle"
                android:text="Coach Message" />

            <View style="@style/GridSync.AccentRule" />

            <EditText
                android:id="@+id/messageInput"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="18dp"
                android:layout_weight="1"
                android:background="@drawable/gridsync_input_background"
                android:gravity="top|start"
                android:hint="Type your message to selected roles"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:padding="18dp"
                android:textColor="@color/gridsync_text_primary"
                android:textColorHint="@color/gridsync_text_muted"
                android:textSize="22sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/sendButton"
                style="@style/GridSync.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Send Message" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rightPanel"
            style="@style/GridSync.Panel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:paddingHorizontal="22dp"
            android:paddingTop="22dp"
            android:paddingBottom="12dp">

            <TextView
                style="@style/GridSync.PanelTitle"
                android:text="Role and Status" />

            <View style="@style/GridSync.AccentRule" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="ROLE"
                    android:textColor="@color/gridsync_text_muted"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:letterSpacing="0.08"
                    android:text="STATUS"
                    android:textColor="@color/gridsync_text_muted"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="SEND"
                    android:textColor="@color/gridsync_text_muted"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View style="@style/GridSync.Divider" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/roleStatusContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>

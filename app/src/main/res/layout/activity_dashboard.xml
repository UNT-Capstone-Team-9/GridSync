<?xml version="1.0" encoding="utf-8"?>
<!-- Dark football-tech dashboard, matched to app/docs:ui-reference/gridsync-dashboard-reference.png.
     DashboardActivity looks up the card, status and list ids below, so keep them when editing. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dashboardRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gridsync_background">

    <LinearLayout
        android:id="@+id/headerBar"
        style="@style/GridSync.Header"
        android:layout_width="0dp"
        android:layout_height="92dp"
        android:paddingStart="28dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/headerLogo"
            android:layout_width="64dp"
            android:layout_height="74dp"
            android:adjustViewBounds="true"
            android:contentDescription="GridSync logo"
            android:scaleType="fitCenter"
            android:src="@drawable/gridsync_logo_shield" />

        <TextView
            android:id="@+id/headerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_weight="1"
            android:text="@string/gridsync_wordmark"
            android:textColor="@color/gridsync_text_primary"
            android:textSize="40sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/settingsIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="bottom"
            android:layout_marginBottom="10dp"
            android:background="@drawable/dashboard_icon_ripple"
            android:clickable="true"
            android:contentDescription="Settings"
            android:focusable="true"
            android:padding="11dp"
            android:src="@android:drawable/ic_menu_manage"
            app:tint="@color/gridsync_text_primary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/statusBar"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/dashboard_panel_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerBar">

        <View
            android:id="@+id/networkStatusDot"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:background="@drawable/gridsync_status_ring" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Network Status"
            android:textColor="@color/gridsync_text_secondary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/networkStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="Listening"
            android:textColor="@color/gridsync_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <View
            android:layout_width="1dp"
            android:layout_height="26dp"
            android:layout_marginHorizontal="24dp"
            android:background="@color/gridsync_border" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@android:drawable/ic_menu_share"
            app:tint="@color/gridsync_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Watches"
            android:textColor="@color/gridsync_text_secondary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/watchCountText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="0 active / 0 assigned"
            android:textColor="@color/gridsync_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/createPlayCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/assignWatchesCard"
        app:layout_constraintEnd_toStartOf="@id/playsCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusBar"
        android:background="@drawable/gridsync_card_play"
        android:clickable="true"
        android:elevation="4dp"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingVertical="10dp">

        <ImageView
            style="@style/GridSync.CardIcon"
            android:src="@drawable/ic_gs_add_circle" />

        <TextView
            style="@style/GridSync.CardTitle"
            android:text="Create New Play" />

        <TextView
            style="@style/GridSync.CardBody"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Design a formation, routes and assignments" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/playsCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/sendPlayCard"
        app:layout_constraintEnd_toStartOf="@id/playerStatusPanel"
        app:layout_constraintStart_toEndOf="@id/createPlayCard"
        app:layout_constraintTop_toBottomOf="@id/statusBar"
        android:background="@drawable/gridsync_card_play"
        android:clickable="true"
        android:elevation="4dp"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingVertical="10dp">

        <ImageView
            style="@style/GridSync.CardIcon"
            android:src="@drawable/ic_gs_playbook" />

        <TextView
            style="@style/GridSync.CardTitle"
            android:text="Plays" />

        <TextView
            style="@style/GridSync.CardBody"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Play Library and Hurry-Up Packages" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/assignWatchesCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/sessionLogPanel"
        app:layout_constraintEnd_toStartOf="@id/sendPlayCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/createPlayCard"
        android:background="@drawable/gridsync_card_watch"
        android:clickable="true"
        android:elevation="4dp"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingVertical="10dp">

        <ImageView
            style="@style/GridSync.CardIcon"
            android:src="@drawable/ic_gs_assign" />

        <TextView
            style="@style/GridSync.CardTitle"
            android:text="Assign Watches" />

        <TextView
            style="@style/GridSync.CardBody"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Pair player watches with roles" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sendPlayCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/sessionLogPanel"
        app:layout_constraintEnd_toStartOf="@id/playerStatusPanel"
        app:layout_constraintStart_toEndOf="@id/assignWatchesCard"
        app:layout_constraintTop_toBottomOf="@id/playsCard"
        android:background="@drawable/gridsync_card_message"
        android:clickable="true"
        android:elevation="4dp"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingVertical="10dp">

        <ImageView
            style="@style/GridSync.CardIcon"
            android:src="@drawable/ic_gs_send" />

        <TextView
            style="@style/GridSync.CardTitle"
            android:text="Send Messages" />

        <TextView
            style="@style/GridSync.CardBody"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Send text instructions or messages to selected player roles" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/playerStatusPanel"
        style="@style/GridSync.Panel"
        android:layout_width="300dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/sessionLogPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusBar">

        <TextView
            style="@style/GridSync.PanelTitle"
            android:layout_marginStart="22dp"
            android:layout_marginTop="18dp"
            android:text="Player Status" />

        <View
            style="@style/GridSync.AccentRule"
            android:layout_marginStart="22dp" />

        <View
            style="@style/GridSync.Divider"
            android:layout_marginHorizontal="22dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/playerStatusListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="22dp"
                android:paddingBottom="8dp" />
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sessionLogPanel"
        style="@style/GridSync.Panel"
        android:layout_width="0dp"
        android:layout_height="156dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:paddingHorizontal="26dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_gs_log" />

            <TextView
                style="@style/GridSync.PanelTitle"
                android:layout_marginStart="14dp"
                android:text="Session Activity Log"
                android:textSize="20sp" />
        </LinearLayout>

        <View
            style="@style/GridSync.Divider"
            android:layout_marginTop="12dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/sessionLogListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

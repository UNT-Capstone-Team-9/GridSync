<?xml version="1.0" encoding="utf-8"?>
<!-- Assign Watches in the shared GridSync dark style. AssignWatchesActivity looks up the ids below. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gridsync_background"
    android:orientation="vertical">

    <LinearLayout style="@style/GridSync.Header">

        <ImageButton
            android:id="@+id/backButton"
            style="@style/GridSync.BackButton" />

        <ImageView style="@style/GridSync.HeaderLogo" />

        <TextView
            android:id="@+id/titleText"
            style="@style/GridSync.ScreenTitle"
            android:text="Assign Watches" />
    </LinearLayout>

    <!-- Pair code and connection status, styled like the dashboard status bar. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/dashboard_panel_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_gs_watch" />

        <TextView
            android:id="@+id/pairCodeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Pair code CLOUD9"
            android:textColor="@color/gridsync_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <View
            android:layout_width="1dp"
            android:layout_height="26dp"
            android:layout_marginHorizontal="24dp"
            android:background="@color/gridsync_border" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 watches connected"
            android:textColor="@color/gridsync_green_bright"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        style="@style/GridSync.Panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="20dp"
        android:layout_weight="1"
        android:paddingHorizontal="22dp"
        android:paddingTop="18dp"
        android:paddingBottom="12dp">

        <TextView
            style="@style/GridSync.PanelTitle"
            android:text="Connected Watches" />

        <View style="@style/GridSync.AccentRule" />

        <TextView
            android:id="@+id/helperText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Tap a connected watch to assign a role"
            android:textColor="@color/gridsync_text_secondary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/emptyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:gravity="center"
            android:text="No watches connected yet"
            android:textColor="@color/gridsync_text_muted"
            android:textSize="18sp" />

        <ListView
            android:id="@+id/watchListView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:divider="@android:color/transparent"
            android:dividerHeight="10dp"
            android:listSelector="@android:color/transparent" />
    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Plays hub in the shared GridSync dark style. PlaysActivity looks up the ids below. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gridsync_background"
    android:orientation="vertical">

    <LinearLayout style="@style/GridSync.Header">

        <ImageButton
            android:id="@+id/backButton"
            style="@style/GridSync.BackButton" />

        <ImageView style="@style/GridSync.HeaderLogo" />

        <TextView
            style="@style/GridSync.ScreenTitle"
            android:text="Plays" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="20dp">

        <LinearLayout
            android:id="@+id/playLibraryOption"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/gridsync_card_play"
            android:clickable="true"
            android:elevation="4dp"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <ImageView
                style="@style/GridSync.CardIcon"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:src="@drawable/ic_gs_playbook" />

            <TextView
                style="@style/GridSync.CardTitle"
                android:layout_marginTop="20dp"
                android:text="Play Library"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/playLibraryCountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/gridsync_green_bright"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                style="@style/GridSync.CardBody"
                android:layout_marginTop="12dp"
                android:maxWidth="380dp"
                android:text="All saved football plays. Browse visually by formation, personnel, run/pass, and play name."
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hurryUpOption"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/gridsync_card_plain"
            android:clickable="true"
            android:elevation="4dp"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <ImageView
                style="@style/GridSync.CardIcon"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:src="@drawable/ic_gs_hurry_up" />

            <TextView
                style="@style/GridSync.CardTitle"
                android:layout_marginTop="20dp"
                android:text="Hurry-Up Packages"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/hurryUpCountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/gridsync_green_bright"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                style="@style/GridSync.CardBody"
                android:layout_marginTop="12dp"
                android:maxWidth="380dp"
                android:text="Coach-created quick-access groups of saved plays."
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
